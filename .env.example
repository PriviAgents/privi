# Copy to .env.local. Only ANTHROPIC_API_KEY is needed for demo mode:
# a test balance with a faucet, simulated merchants, and an in-memory store.

# --- Agent ---------------------------------------------------------------------
# Required. Get one at https://platform.claude.com
ANTHROPIC_API_KEY=

# --- Helius Privacy Rings (live mode) --------------------------------------------
# Leave HELIUS_API_KEY or PRIVI_TREASURY_SECRET empty to stay in demo mode.
HELIUS_API_KEY=
# "mainnet" (default) or "devnet".
PRIVI_RINGS_NETWORK=devnet
# Treasury signer that owns the pooled ring balance. Generate with:
#   node scripts/new-treasury.mjs     (writes it here without printing it; back it up)
PRIVI_TREASURY_SECRET=
# SOL kept public on the treasury for fees and rent (not swept into the ring).
PRIVI_TREASURY_SOL_RESERVE=0.05
# Optional overrides:
# HELIUS_RPC_URL=  HELIUS_SPR_INDEXER_URL=  HELIUS_SPR_PROVER_URL=  PRIVI_RINGS_USDC_MINT=

# --- Storage (required in production) ------------------------------------------
# Upstash Redis. Either pair works; the Vercel integration injects KV_REST_API_*.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Merchants (optional) --------------------------------------------------------
# Gift cards.
# BITREFILL_API_KEY=
# Store orders and flights/hotels are paid via x402 from the spend wallet.
# Set to "1" to turn a rail off.
# PRIVI_ZINC_DISABLED=
# PRIVI_BRIJ_DISABLED=
# USDC kept in the spend wallet for x402 payments (default 50).
# PRIVI_SPEND_FLOAT_USD=

# --- Operations ---------------------------------------------------------------------
# Bearer token for /admin and /api/admin/*. 24+ random characters.
PRIVI_ADMIN_TOKEN=
# Optional cap on any single account's balance, in USD. Unset = no cap.
# PRIVI_MAX_BALANCE_USD=
# An extra origin allowed to use passkeys (e.g. a preview deployment URL).
# PRIVI_EXTRA_ORIGIN=
